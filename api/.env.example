# ==============================
# Base de Datos (PostgreSQL)
# ==============================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=fitness_db
POSTGRES_PORT=5432

# ==============================
# Autenticación y Seguridad
# ==============================
# JWT Secret (Generar uno fuerte en producción)
JWT_SECRET_KEY=super_secret_key_change_me_in_production_9f2f8b

# SuperAdmin
SUPERADMIN_EMAIL=admin@entrenadorpremium.com
SUPERADMIN_PASSWORD=SuperAdmin_Fitness_2026X!

# ==============================
# Almacenamiento (Cloudflare R2)
# ==============================
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=fitness-assets-dev
R2_PUBLIC_DOMAIN=https://assets-dev.yourdomain.com

# Sentry APM
SENTRY_DSN=

# ==============================
# Servicio de Correos (Email & Notificaciones Legales)
# ==============================
# Email remitente oficial de la plataforma
SMTP_EMAIL=syncrobylaria2026@gmail.com
# Contraseña de aplicación de Google (16 caracteres, ej: "abcd efgh ijkl mnop")
SMTP_PASSWORD=tu_contrasena_de_aplicacion_google

# Google Apps Script Relay (Recomendado para Render sin bloqueo de puertos y sin necesidad de dominio propio)
GMAIL_RELAY_URL=https://script.google.com/macros/s/AKfycb.../exec
GMAIL_RELAY_SECRET=tu_secreto_opcional

# Alternativas API HTTP
RESEND_API_KEY=re_...
BREVO_API_KEY=xkeysib-...

# URL de la PWA (Frontend) para la generación de enlaces de autorización parental y login
FRONTEND_URL=https://syncro-clone.vercel.app

